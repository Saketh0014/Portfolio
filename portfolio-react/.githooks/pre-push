#!/bin/sh
# Block risky npm dependency changes before they leave the machine.
# git feeds: <local ref> <local sha> <remote ref> <remote sha> per pushed ref.
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue            # branch deletion
  base="$remote_sha"
  if [ "$base" = "$zero" ]; then                    # new branch: compare to the default branch
    base=""
    for ref in origin/main origin/master; do
      if git rev-parse --verify -q "$ref" >/dev/null; then
        base=$(git merge-base "$ref" "$local_sha"); break
      fi
    done
    [ -z "$base" ] && base=4b825dc642cb6eb9a060e54bf8d69288fbee4904
  fi
  python3 "$root/scripts/npm-guard/check_dependency_changes.py" --base "$base" --head "$local_sha" || status=1
done
exit $status
